{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobflow.dev/contracts/events/job-captured.v1.json",
  "title": "JobCaptured.v1",
  "type": "object",
  "required": ["eventId", "eventType", "tenantId", "userId", "correlationId", "idempotencyKey", "occurredAt", "payload"],
  "properties": {
    "eventId": {"type": "string"},
    "eventType": {"const": "JobCaptured.v1"},
    "tenantId": {"type": "string"},
    "userId": {"type": "string"},
    "correlationId": {"type": "string"},
    "idempotencyKey": {"type": "string"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "payload": {
      "type": "object",
      "required": ["url", "title", "source", "capturedAt"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "title": {"type": "string", "minLength": 1},
        "company": {"type": "string"},
        "role": {"type": "string"},
        "location": {"type": "string"},
        "source": {"type": "string", "minLength": 1},
        "descriptionPreview": {"type": "string"},
        "capturedAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
