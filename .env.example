NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
JOB_SERVICE_URL=http://localhost:8091
JOBFLOW_OIDC_ISSUER_URI=
JOBFLOW_OIDC_CLIENT_ID=
JOBFLOW_OIDC_CLIENT_SECRET=
JOBFLOW_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Auth0 API Identifier; required for a JWT access token trusted by Job service.
JOBFLOW_OIDC_AUDIENCE=
JOBFLOW_OIDC_TOKEN_ENDPOINT=
IDENTITY_SERVICE_URL=http://localhost:8081
JOBFLOW_INTERNAL_SERVICE_KEY=
JOBFLOW_SESSION_ENCRYPTION_KEY=
JOBFLOW_IDENTITY_DB_URL=jdbc:h2:file:./data/jobflow-identity
JOBFLOW_IDENTITY_DB_USERNAME=sa
JOBFLOW_IDENTITY_DB_PASSWORD=
JOBFLOW_IDENTITY_DDL_AUTO=validate
JOBFLOW_JOB_DB_URL=jdbc:h2:file:./data/jobflow-jobs;AUTO_SERVER=TRUE
JOBFLOW_JOB_DB_USERNAME=sa
JOBFLOW_JOB_DB_PASSWORD=
JOBFLOW_JOB_DDL_AUTO=validate
AWS_REGION=ap-south-1
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback
JOBFLOW_GMAIL_TOKEN_ENCRYPTION_KEY=
INGESTION_SERVICE_URL=http://localhost:8082
# Durable Gmail backfill queue. Keep disabled until LocalStack or AWS queue URLs are configured.
JOBFLOW_SQS_ENABLED=false
JOBFLOW_SQS_ENDPOINT=http://localhost:4566
JOBFLOW_SQS_BACKFILL_QUEUE_URL=http://localhost:4566/000000000000/jobflow-gmail-backfill
JOBFLOW_SQS_BACKFILL_DLQ_URL=http://localhost:4566/000000000000/jobflow-gmail-backfill-dlq
JOBFLOW_SQS_VISIBILITY_TIMEOUT_SECONDS=60
JOBFLOW_SQS_MAX_MESSAGES=10

# Cloud classification. The API key must be injected from Azure Key Vault in deployed environments.
JOBFLOW_CLASSIFIER_PROVIDER=azure-openai
JOBFLOW_GMAIL_CLASSIFICATION_THREADS=4
JOBFLOW_GMAIL_CLASSIFICATION_QUEUE_CAPACITY=1000
AZURE_OPENAI_ENDPOINT=https://shagilnizami786-4527-resource.openai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-luna
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_KEY_VAULT_URI=
AZURE_OPENAI_KEY_SECRET_NAME=azure-openai-key
# Local-only fallback for development when Key Vault injection is unavailable; never commit a value.
AZURE_OPENAI_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
## Set this only after the context database and embedding deployment are ready.
## JOBFLOW_CLASSIFIER_PROVIDER=context-azure
JOBFLOW_CONTEXT_INDEX_ENABLED=false

# Shared AI context service (PostgreSQL + pgvector)
JOBFLOW_CONTEXT_PORT=8084
JOBFLOW_CONTEXT_DB_URL=jdbc:postgresql://localhost:5432/jobflow_context
JOBFLOW_CONTEXT_DB_USERNAME=jobflow
JOBFLOW_CONTEXT_DB_PASSWORD=jobflow
JOBFLOW_EMBEDDING_DIMENSIONS=1536
AI_CONTEXT_SERVICE_URL=http://localhost:8084
CONTACT_DISCOVERY_SERVICE_URL=http://localhost:8093
AI_DRAFT_SERVICE_URL=http://localhost:8086

# Optional contact-discovery providers. Disabled by default; credentials must
# be injected server-side from Key Vault before enabling a provider.
JOBFLOW_APOLLO_ENABLED=false
JOBFLOW_APOLLO_ENDPOINT=https://api.apollo.io/v1/people/match
JOBFLOW_APOLLO_KEY_VAULT_URI=
JOBFLOW_APOLLO_KEY_SECRET_NAME=apollo-api-key
JOBFLOW_HUNTER_ENABLED=false
JOBFLOW_HUNTER_ENDPOINT=https://api.hunter.io/v2/domain-search
JOBFLOW_HUNTER_KEY_VAULT_URI=
JOBFLOW_HUNTER_KEY_SECRET_NAME=hunter-api-key
# Comma-separated HTTPS JSON feeds supplied by official employers/platform APIs.
# Empty means recommendations stay in NO_FEED_CONFIGURED state.
JOBFLOW_OFFICIAL_JOB_FEED_URLS=

JOBFLOW_DRAFT_DB_URL=jdbc:h2:file:./data/jobflow-drafts;AUTO_SERVER=TRUE
JOBFLOW_RESUME_STORAGE_DIR=./data/resumes
