NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
JOB_SERVICE_URL=http://localhost:8091
JOBFLOW_OIDC_ISSUER_URI=
JOBFLOW_OIDC_CLIENT_ID=
JOBFLOW_OIDC_CLIENT_SECRET=
JOBFLOW_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Auth0 API Identifier; required for a JWT access token trusted by Job service.
JOBFLOW_OIDC_AUDIENCE=
JOBFLOW_OIDC_TOKEN_ENDPOINT=
IDENTITY_SERVICE_URL=http://localhost:8081
JOBFLOW_INTERNAL_SERVICE_KEY=
JOBFLOW_SESSION_ENCRYPTION_KEY=
JOBFLOW_IDENTITY_DB_URL=jdbc:h2:file:./data/jobflow-identity
JOBFLOW_IDENTITY_DB_USERNAME=sa
JOBFLOW_IDENTITY_DB_PASSWORD=
JOBFLOW_IDENTITY_DDL_AUTO=validate
JOBFLOW_JOB_DB_URL=jdbc:h2:file:./data/jobflow-jobs;AUTO_SERVER=TRUE
JOBFLOW_JOB_DB_USERNAME=sa
JOBFLOW_JOB_DB_PASSWORD=
JOBFLOW_JOB_DDL_AUTO=validate
AWS_REGION=ap-south-1
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback
JOBFLOW_GMAIL_TOKEN_ENCRYPTION_KEY=
INGESTION_SERVICE_URL=http://localhost:8082
# Durable Gmail backfill queue. Keep disabled until LocalStack or AWS queue URLs are configured.
JOBFLOW_SQS_ENABLED=false
JOBFLOW_SQS_ENDPOINT=http://localhost:4566
JOBFLOW_SQS_BACKFILL_QUEUE_URL=http://localhost:4566/000000000000/jobflow-gmail-backfill
JOBFLOW_SQS_BACKFILL_DLQ_URL=http://localhost:4566/000000000000/jobflow-gmail-backfill-dlq
JOBFLOW_SQS_VISIBILITY_TIMEOUT_SECONDS=60
JOBFLOW_SQS_MAX_MESSAGES=10
